-- Zone Operations (Mixon) - MCM settings (file name must end with mcm.script)
function on_mcm_load()
	return {
		id = "zop", sh = true,
		gr = {
			{ id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_zop_title", size = { 512, 50 }, spacing = 20 },
			{ id = "enabled", type = "check", val = 1, def = true },
			{ id = "reward_mult", type = "track", val = 2, min = 0.5, max = 3, step = 0.1, def = 1 },
			{ id = "extra_squads", type = "track", val = 2, min = 0, max = 2, step = 1, def = 0 },
			{ id = "voice_lang", type = "list", val = 2, def = 0, content = { { 0, "zop_vlang_auto" }, { 1, "zop_vlang_ru" }, { 2, "zop_vlang_en" } } },
		},
	}
end
