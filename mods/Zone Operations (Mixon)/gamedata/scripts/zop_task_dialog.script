--[[
	Zone Operations (Mixon) - more "another job?" steps in the stock task dialog.

	dialog_manager.dm_init_dynamic_task_dialog (dm_ordered_task_dialog, the dialog of every named
	task giver) builds a fixed chain of 10 blocks: "here is a job" -> accept / another one / leave.
	A giver with more than 10 available tasks can never show the rest: the 10th "another one" has
	nothing after it. Kholodny has 24 tasks.

	The stock function is left as it is and called first; then the same block is appended for
	steps 11..BLOCKS with the stock helpers and the stock dialogs.* functions. The chain is walked
	one "another one" at a time and each step is shown only while the giver still has a task
	(dialogs.npc_has_task), so a giver with fewer than 10 tasks never reaches the new blocks.
	Phrase ids go on in tens from 100; 900 / 901 are the stock "you already have my task" pair,
	so BLOCKS must stay below 90.
]]

local BLOCKS = 40

local function more_blocks()
	local dm = dialog_manager
	local base_id = 100 -- the stock chain ends with the "another one" phrase 100
	for i = 11, BLOCKS do
		dm.add_script_dialog(base_id, base_id + 1, "dialogs.text_npc_has_task", "dialogs.not_has_tasks_by_npc")
		dm.add_dialog(base_id + 1, base_id + 2, "st_ordered_task_accept", "dialogs.npc_has_task", "dialogs.npc_give_task")
		dm.add_dialog(base_id + 2, base_id + 3, "st_accepted_task_" .. math.random(1, 3))
		dm.add_dialog(base_id + 3, base_id + 4, "dm_universal_actor_exit_thanks")
		-- the last block has no step after it: no "another one" that would lead nowhere
		if i < BLOCKS then
			dm.add_dialog(base_id + 1, base_id + 10, "st_ordered_task_next", "dialogs.npc_has_task", "dialogs.npc_skip_task")
		end
		dm.add_dialog(base_id + 1, base_id + 8, "dm_universal_actor_exit")
		base_id = base_id + 10
	end
end

function on_game_start()
	local ok, err = pcall(function()
		local dm = dialog_manager
		local stock = dm and dm.dm_init_dynamic_task_dialog
		if type(stock) ~= "function" or dm.zop_task_blocks or not (dm.add_dialog and dm.add_script_dialog) then
			return
		end
		dm.zop_task_blocks = BLOCKS
		dm.dm_init_dynamic_task_dialog = function(dialog)
			stock(dialog) -- leaves the dialog set for add_dialog
			local ok2, err2 = pcall(more_blocks)
			if not ok2 then
				printf("![ZOP] task dialog: extra blocks failed: %s", tostring(err2))
			end
		end
	end)
	if not ok then
		printf("![ZOP] task dialog patch failed: %s", tostring(err))
	end
end
