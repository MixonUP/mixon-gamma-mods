--[[
	Zone Operations (Mixon) - the mercenaries' operation in the Dead City ("Clean Field").

	Two linked operations of zop_core (configs\misc\zone_ops\zop_operations.ltx):
	  killer_deadcity  defense of the merc HQ (cit_killers) against army spetsnaz
	  killer_admin     the mercs' assault on the Administration (cit_killers_vs_bandits), started
	                   by zop_core itself when the defense is won (on_success_start)

	This script adds what the generic engine has no fields for:
	  - 6 spetsnaz squads holding the Administration from the start (they stay there and are
	    the enemy of killer_admin; ids kept in mst.garrison, saved);
	  - a flank group of 2 squads that sets out with wave 1 from the west;
	  - merc reinforcements from cit_killers_2: the first 3 minutes after the attack, then every 5;
	  - the army helicopter "Sokol-1" over the HQ (zop_merc_heli: flight, fire, death);
	  - the roof team: sniper "Gyurza" (Barrett M82) and RPG gunner "Kuvalda", 3 minutes after
	    the attack; they work on the helicopter (scripted shots), then on the infantry;
	  - 5 mines before the Administration entrance (killer_admin), set off by anybody;
	  - the radio (zop_radio) on every event;
	  - the loss rule: Dushman dead, or the player away from the HQ for 2 real minutes.
	Story NPCs of the HQ (Dushman, Hog, Surgeon, the barman) cannot be killed during the defense.

	State: per operation in zop_core's s.merc (saved with it); between the two operations in
	m_data.zop_merc (garrison, roof team, mines).
]]

local OP_DEF, OP_ADM = "killer_deadcity", "killer_admin"
-- the mirror for the army: the same Dead City battle, the player storms the merc HQ with the spetsnaz
local OP_ARMY = "army_deadcity"
local HQ, ADMIN, REINF_FROM = "cit_killers", "cit_killers_vs_bandits", "cit_killers_2"

local GARRISON_SQUAD, GARRISON_COUNT = "zop_army_spetsnaz_hold", 6
local FLANK_SQUAD, FLANK_COUNT = "zop_army_spetsnaz", 2
local FLANK_AT = { x = -149.80, y = 2.31, z = 60.20, lvid = 46951, gvid = 2345 }
local REINF_SQUAD = "zop_killer_reinforce"
local REINF_FIRST, REINF_EVERY, REINF_CAP = 60, 180, 6
local INSIDE_AT_S = 30   -- real s after the attack: one merc squad appears inside the HQ building   -- real s after the attack; live squads at most
local HELI_AT_S = 4      -- real s after the attack starts
local ROOF_AT_S = HELI_AT_S + 30   -- the roof team comes up 30 s after the helicopter
-- the roof team's spots on the ridge of the HQ roof (shown by the author in game). There is no AI
-- mesh up there: they are spawned on the floor below (lvid) and put on the spot (pos) every frame
-- while the helicopter flies (roof_hold_frame); then they are let go and walk down to the others.
-- (npc:command() hangs this engine build: they are never given scripted actions)
local ROOF = {
	sniper = { section = "zop_killer_roof_sniper", pos = { -59.78, 16.33, 19.57 }, lvid = 94955,
		weapon = "wpn_m82", ammo = "ammo_12.7x55_ap", n = 60 },
	rpg    = { section = "zop_killer_roof_rpg",    pos = { -25.34, 16.33, 19.57 }, lvid = 117854,
		weapon = "wpn_rpg7", ammo = "ammo_og-7b", n = 6 },
}
local roof_held = {}     -- [npc id] = spot vector, held every frame (runtime)
local roof_down = {}     -- [npc id] = level vertex below his spot: where he is put when let go

-- the roof team is let go: vulnerable again, put on the floor below (a 16 m roof with no AI mesh)
local function roof_let_go()
	if zop_roof_fire then
		zop_roof_fire.aim = {}   -- they stop aiming at the helicopter
	end
	for id in pairs(roof_held) do
		local o = level.object_by_id(id)
		if o and o:alive() then
			pcall(function() o:invulnerable(false) end)
			local lv = roof_down[id]
			if lv then
				pcall(function() o:set_npc_position(level.vertex_position(lv)) end)
			end
		end
	end
	roof_held, roof_down = {}, {}
end
-- the HQ's key NPCs: unkillable for the whole operation (the defense and the assault)
local PROTECT = { "cit_killers_merc_trader_stalker", "cit_killers_merc_mechanic_stalker",
	"cit_killers_merc_medic_stalker", "cit_killers_merc_barman_mlr", "cit_killers_merc_barman_stalker",
	"ds_killer_guide_main_base" }
local DUSHMAN = "cit_killers_merc_trader_stalker"
local AWAY_DIST, AWAY_S = 300, 120
local LOST_R, LOST_S = 70, 20     -- no merc fighter within LOST_R m of the HQ for LOST_S s = lost
-- mines: 5 spots on an arc before the Administration's entrance
local MINE_SECTION, MINE_R, MINE_ARM_S = "zop_mine", 2.5, 2
local MINES = { { -58.1, -52.0 }, { -61.0, -53.5 }, { -64.0, -52.5 }, { -55.5, -54.5 }, { -66.5, -54.5 } }
-- the mercs' own minefield by the monument, laid when the defense starts: set off by soldiers only
-- (the author's spot in game: the Lenin monument square, 55 m from the Administration, 77 m from the HQ)
local MONUMENT = { x = -42.09, y = 2.21, z = -19.23 }
-- one in the middle, then rings: { count, radius } (17 mines in all - the author: they look great)
local MERC_RINGS = { { 6, 10 }, { 10, 18 } }

local function merc_mine_spots()
	local out = { { MONUMENT.x, MONUMENT.y, MONUMENT.z } }
	for ri, ring in ipairs(MERC_RINGS) do
		local cnt, R = ring[1], ring[2]
		for i = 1, cnt do
			-- the outer ring is turned half a step, so the mines do not stand in rows
			local a = (i - (ri % 2 == 0 and 0.5 or 1)) * 6.283 / cnt
			-- a spot off the AI mesh (the monument's plinth, a wall) is tried closer in, then farther
			for _, r in ipairs({ R, R * 0.7, R * 1.25 }) do
				local x, z = MONUMENT.x + math.cos(a) * r, MONUMENT.z + math.sin(a) * r
				local lv = level.vertex_id(vector():set(x, MONUMENT.y + 2, z))
				if lv and lv < 4294967295 and math.abs(level.vertex_position(lv).y - MONUMENT.y) < 2 then
					out[#out + 1] = { x, MONUMENT.y, z }
					break
				end
			end
		end
	end
	return out
end

local mst = { garrison = {}, roof = {}, mines = {} }   -- saved in m_data.zop_merc
local next_tick, next_mines = 0, 0
local mine_arm = {}      -- [mine id] = time_global when it arms (runtime: after a reload they are armed)
local LEVEL = "l09_deadcity"

local function on_level()
	return level.name() == LEVEL
end

local function tr(id) return game.translate_string(id) end
local function news(id)
	if db.actor then
		pcall(news_manager.send_tip, db.actor, tr(id), nil, nil, 10000)
	end
end
local function smart(name) return zop_census.smart_by_name(name) end
local function say(id) zop_radio.say(id) end

-- sec: the squad's section when known (sets keep it; true from older saves = id only)
local function alive_squad(sid, sec)
	local sq = zop_spawn.valid_squad(sid, sec)
	return sq and sq:npc_count() > 0 and sq or nil
end

local function count_alive(set)
	local n = 0
	for sid, sec in pairs(set or {}) do
		if alive_squad(sid, sec) then
			n = n + 1
		end
	end
	return n
end

local function force_online(set)
	for sid, sec in pairs(set or {}) do
		local sq = zop_spawn.valid_squad(sid, sec)
		if sq then
			sq.force_online = true
			sq.forced_online_status = true
		end
	end
end

local function unforce(set)
	for sid, sec in pairs(set or {}) do
		local sq = zop_spawn.valid_squad(sid, sec)
		if sq then
			sq.force_online, sq.forced_online_status = nil, nil
		end
	end
end

------------------------------------------------------------------ protection of the HQ's story NPCs
local protected = {}     -- [npc id] = true while the defense runs (runtime, rebuilt by the tick)
local orig_need_inv

local function need_inv(npc)
	if npc and protected[npc:id()] then
		return true
	end
	return orig_need_inv(npc)
end

-- zop_battle switches invulnerability off in the battle zone unless told to keep it
local function share_protected()
	if zop_battle then
		zop_battle.keep_protected = protected
	end
end

local function protect(on)
	protected = {}
	if on then
		for _, sid in ipairs(PROTECT) do
			local id = get_story_object_id(sid)
			if id then
				protected[id] = true
				local o = level.object_by_id(id)
				if o and o:alive() and not o:invulnerable() then
					o:invulnerable(true)
				end
			end
		end
	end
	share_protected()
	-- installed once, over zop_battle's own wrapper
	if on and not orig_need_inv and stalker_generic and stalker_generic.is_need_invulnerability then
		orig_need_inv = stalker_generic.is_need_invulnerability
		stalker_generic.is_need_invulnerability = need_inv
	end
end

------------------------------------------------------------------ squads
local function spawn(section, se_at, target, at)
	local sq = zop_spawn.squad_at_smart(section, se_at, target, at)
	return sq and sq.id
end

-- the Administration's spetsnaz: they hold it from the start and stay there
local function spawn_garrison(op_id)
	local se_a = smart(ADMIN)
	if not se_a then
		return
	end
	mst.garrison = {}
	for _ = 1, GARRISON_COUNT do
		local id = spawn(GARRISON_SQUAD, se_a, ADMIN)
		if id then
			mst.garrison[id] = GARRISON_SQUAD
		end
	end
	-- whoever lived there moves out (bandits, loners)
	local away = zop_spawn.muster_smart(se_a, 300, 700) or zop_spawn.muster_smart(se_a, 200, 900)
	local sb = SIMBOARD.smarts[se_a.id]
	for sid in pairs(sb and sb.squads or {}) do
		local sq = alife():object(sid)
		if sq and not mst.garrison[sid] and sq.player_id ~= "army" and away and not get_object_story_id(sid) then
			pcall(zop_spawn.steer, sq, away:name(), false)
			-- released by zop_core when the operation ends
			zop_core.add_squad(op_id or OP_DEF, "evicted", sid)
		end
	end
end

local function keep_garrison()
	for sid, sec in pairs(mst.garrison) do
		local sq = alive_squad(sid, sec)
		if not sq then
			mst.garrison[sid] = nil
		elseif sq.scripted_target ~= ADMIN then
			zop_spawn.steer(sq, ADMIN, false)
		end
	end
	force_online(mst.garrison)
end

local function release_garrison()
	unforce(mst.garrison)
	for sid, sec in pairs(mst.garrison) do
		pcall(zop_spawn.steer_by_id, sid, nil, false, sec)
	end
	mst.garrison = {}
end

local function spawn_flank(s)
	-- registered with the smart next to the spot: a squad registered with the HQ itself is put
	-- straight onto the HQ's job places
	local se_hq = smart(HQ)
	local se_at = se_hq and zop_spawn.nearest_smart(vector():set(FLANK_AT.x, FLANK_AT.y, FLANK_AT.z), FLANK_AT.gvid, se_hq.id)
	local n = 0
	for _ = 1, FLANK_COUNT do
		local id = spawn(FLANK_SQUAD, se_at, HQ, FLANK_AT)
		if id and zop_core.add_squad(OP_DEF, "squads", id) then
			n = n + 1
		end
	end
	if n > 0 then
		news("st_zop_killer_flank")
	end
end

local function reinforce(s, m)
	local live = 0
	for sid, sec in pairs(m.reinf or {}) do
		if alive_squad(sid, sec) then
			live = live + 1
		end
	end
	if live >= REINF_CAP then
		return
	end
	local id = spawn(REINF_SQUAD, smart(REINF_FROM), HQ)
	if id then
		m.reinf = m.reinf or {}
		m.reinf[id] = REINF_SQUAD
		zop_core.add_squad(OP_DEF, "defenders", id)
		say("d03")
		news("st_zop_killer_reinforce")
	end
end

-- reinforcements that arrived but stand idle (the HQ's peaceful jobs, the enemy not seen yet) are
-- shown the nearest attackers: then the combat planner takes them into the fight
local next_wake = 0
local function wake_reinforcements(s, m)
	if time_global() < next_wake or not next(m.reinf or {}) then
		return
	end
	next_wake = time_global() + 3000
	local se_hq = smart(HQ)
	if not (se_hq and zop_census.actor_near(se_hq, 220)) then
		return
	end
	-- the battle zone at the HQ (zop_core keeps it open while the player is there): the
	-- reinforcements are revealed against the spetsnaz inside it, wherever they stand
	zop_battle.reveal(m.reinf, se_hq, "army", 150, nil, { busy = true, wake = true, own_clock = true })
end

------------------------------------------------------------------ the roof team
local function roof_spawn()
	local se_hq = smart(HQ)
	if not se_hq then
		return
	end
	mst.roof = mst.roof or {}
	for key, r in pairs(ROOF) do
		if not (mst.roof[key] and alive_squad(mst.roof[key], r.section)) then
			local pos = level.vertex_position(r.lvid)
			local at = { x = pos.x, y = pos.y, z = pos.z, lvid = r.lvid, gvid = se_hq.m_game_vertex_id }
			local id = spawn(r.section, se_hq, HQ, at)
			local sq = id and alife():object(id)
			if sq then
				mst.roof[key] = id
				for m in sq:squad_members() do
					local npc = alife():object(m.id)
					if npc then
						pcall(alife_create_item, r.weapon, npc)
						for _ = 1, r.n do
							pcall(alife_create_item, r.ammo, npc)
						end
					end
				end
			end
		end
	end
	say("m01")
	say("m02")
end

-- the members of the roof team, online and alive: { sniper = obj, rpg = obj }
local function roof_men()
	local out = {}
	for key, sid in pairs(mst.roof or {}) do
		local sq = alive_squad(sid, ROOF[key] and ROOF[key].section)
		if sq then
			for m in sq:squad_members() do
				local o = level.object_by_id(m.id)
				if o and o:alive() then
					out[key] = o
				end
			end
		end
	end
	return out
end

-- once a second: who is to be held on the roof (the frame callback below does the holding)
local function roof_hold(enemy)
	roof_held = {}
	for key, sid in pairs(mst.roof or {}) do
		local sq = alive_squad(sid, ROOF[key] and ROOF[key].section)
		local r = ROOF[key]
		if sq and r then
			sq.force_online, sq.forced_online_status = true, true
			if sq.scripted_target ~= HQ then
				zop_spawn.steer(sq, HQ, false)
			end
			for m in sq:squad_members() do
				roof_held[m.id] = vector():set(r.pos[1], r.pos[2], r.pos[3])
				roof_down[m.id] = r.lvid
				-- out in the open on the ridge they would be the first to die: unkillable while held
				-- (not in the army mirror: there they are the player's targets)
				if not enemy then
					protected[m.id] = true
					local o = level.object_by_id(m.id)
					if o and o:alive() and not o:invulnerable() then
						o:invulnerable(true)
					end
				end
			end
		end
	end
end

-- every frame: the roof is pitched and has no AI mesh, so a man left alone slides down at once
local function roof_hold_frame()
	if not next(roof_held) then
		return
	end
	for id, spot in pairs(roof_held) do
		local o = level.object_by_id(id)
		if not (o and o:alive()) then
			roof_held[id] = nil
		elseif o:position():distance_to_sqr(spot) > 0.04 then
			pcall(function() o:set_npc_position(spot) end)
		end
	end
end

local function release_roof()
	for key, sid in pairs(mst.roof or {}) do
		local sq = zop_spawn.valid_squad(sid, ROOF[key] and ROOF[key].section)
		if sq then
			sq.force_online, sq.forced_online_status = nil, nil
		end
	end
	mst.roof = {}
	roof_held, roof_down = {}, {}
end

------------------------------------------------------------------ mines
-- spots: { {x, z} or {x, y, z}, ... }; owner: the community that laid them (never sets them off;
-- the player neither, when they are the mercs' own)
local function mines_place(spots, smart_name, owner)
	mst.mines = mst.mines or {}
	local se_s = smart(smart_name)
	if not se_s then
		return
	end
	local n = 0
	for _, xz in ipairs(spots) do
		local x, y, z = xz[1], xz[3] and xz[2] or se_s.position.y, xz[3] or xz[2]
		local lvid = level.vertex_id(vector():set(x, y + 2, z))
		if lvid and lvid < 4294967295 then
			local pos = level.vertex_position(lvid)
			local ok, se = pcall(alife_create, MINE_SECTION, pos, lvid, se_s.m_game_vertex_id)
			if ok and se then
				mst.mines[se.id] = { x = pos.x, y = pos.y, z = pos.z, owner = owner }
				mine_arm[se.id] = time_global() + MINE_ARM_S * 1000
				n = n + 1
			end
		end
	end
	printf("[ZOP] %s mines placed by %s", tostring(n), tostring(owner))
end

-- Runs every 150 ms while mines lie. The online NPCs are read once per pass (position and
-- community into flat arrays) and every mine is compared against those numbers: before, each mine
-- walked all online NPCs again (~1.3 ms and 100 KB of garbage per pass at 22 mines / 130 NPCs).
local function mines_check()
	if not next(mst.mines) then
		return
	end
	local tg = time_global()
	local sim = alife()
	local r2 = MINE_R * MINE_R
	local nx, ny, nz, nc, n           -- the online NPCs, read when the first armed mine needs them
	local ax, ay, az, acomm          -- the player
	for id, mn in pairs(mst.mines) do
		if not sim:object(id) then
			mst.mines[id] = nil
		elseif tg > (mine_arm[id] or 0) then
			local o = level.object_by_id(id)
			if o then
				if not n then
					nx, ny, nz, nc, n = {}, {}, {}, {}, 0
					for i = 1, #db.OnlineStalkers do
						local s = level.object_by_id(db.OnlineStalkers[i])
						if s and s:alive() then
							local sp = s:position()
							n = n + 1
							nx[n], ny[n], nz[n], nc[n] = sp.x, sp.y, sp.z, character_community(s)
						end
					end
					if db.actor then
						local apos = db.actor:position()
						ax, ay, az, acomm = apos.x, apos.y, apos.z, get_actor_true_community()
					end
				end
				local owner = mn.owner or "army"
				local boom = false
				-- the player sets off the other side's mines (the army mirror: the mercs' minefield)
				if ax and owner ~= acomm then
					local dx, dy, dz = ax - mn.x, ay - mn.y, az - mn.z
					boom = dx * dx + dy * dy + dz * dz < r2
				end
				if not boom then
					for i = 1, n do
						-- whoever laid them knows where they are
						if nc[i] ~= owner then
							local dx, dy, dz = nx[i] - mn.x, ny[i] - mn.y, nz[i] - mn.z
							if dx * dx + dy * dy + dz * dz < r2 then
								boom = true
								break
							end
						end
					end
				end
				if boom then
					mst.mines[id] = nil
					pcall(function() o:explode(0) end)
				end
			end
		end
	end
end

local function mines_clear()
	for id in pairs(mst.mines or {}) do
		local se = alife():object(id)
		if se then
			pcall(safe_release_manager.release, se)
		end
	end
	mst.mines = {}
end

------------------------------------------------------------------ the defense
local function ensure(s)
	s.merc = s.merc or { secs = 0 }
	return s.merc
end

local function tick_defense(s)
	local m = ensure(s)
	protect(true)
	keep_garrison()
	-- the loss rule: Dushman dead, or the player away from the HQ for 2 minutes
	local did = get_story_object_id(DUSHMAN)
	local dse = did and alife():object(did)
	if did and dse and dse.alive and not dse:alive() then
		news("st_zop_killer_dushman_dead")
		return zop_core.end_active(OP_DEF, false)
	end
	local se_hq = smart(HQ)
	if se_hq and db.actor then
		-- (actor_near checks the level too: on another map he is away)
		if not zop_census.actor_near(se_hq, AWAY_DIST) then
			m.away = (m.away or 0) + 1
			if m.away == 30 then
				news("st_zop_killer_come_back")
			end
			if m.away >= AWAY_S then
				return zop_core.end_active(OP_DEF, false)
			end
		else
			m.away = nil
		end
	end
	if s.stage ~= "defend" then
		return
	end
	m.secs = (m.secs or 0) + 1
	-- the HQ has fallen: no merc fighter left at it (story NPCs and the roof team do not count)
	-- while the spetsnaz are still there -> after LOST_S the army reports its operation done
	if se_hq and zop_census.actor_near(se_hq, 300) and m.secs > 20 then
		local held = 0
		for i = 1, #db.OnlineStalkers do
			local o = level.object_by_id(db.OnlineStalkers[i])
			if o and o:alive() and character_community(o) == "killer" and not protected[o:id()]
				and not get_object_story_id(o:id()) and o:position():distance_to(se_hq.position) < LOST_R then
				held = held + 1
			end
		end
		local foes = zop_census.alive_in_squads(s.squads or {})
		if held == 0 and foes > 0 then
			m.lost = (m.lost or 0) + 1
			if m.lost >= LOST_S then
				m.hq_fallen = true
				return zop_core.end_active(OP_DEF, false)
			end
		else
			m.lost = nil
		end
	end
	-- reinforcements: 3 minutes after the attack, then every 5
	-- 30 s in: a squad of mercs inside the HQ building (registered with the HQ, so they are put on
	-- its job places at once - the building holds out longer)
	if m.secs >= INSIDE_AT_S and not m.inside_done then
		m.inside_done = true
		local id = spawn(REINF_SQUAD, smart(HQ), HQ)
		if id then
			m.reinf = m.reinf or {}
			m.reinf[id] = REINF_SQUAD
			zop_core.add_squad(OP_DEF, "defenders", id)
		end
	end
	if m.secs >= (m.next_reinf or REINF_FIRST) then
		m.next_reinf = m.secs + REINF_EVERY
		pcall(reinforce, s, m)
	end
	if not on_level() then
		return
	end
	if m.heli_due and m.secs >= HELI_AT_S then
		m.heli_due = nil
		local ok, err = pcall(zop_merc_heli.spawn, m)
		if not ok then
			printf("![ZOP] merc heli spawn: %s", tostring(err))
		end
		mst.heli = m.heli
	end
	if m.secs >= ROOF_AT_S and not m.roof_done then
		m.roof_done = true
		pcall(roof_spawn)
	end
	-- the roof team is held up there only while the helicopter flies; then they go and fight with the rest
	if m.heli and not m.heli_down then
		roof_hold()
	elseif next(roof_held) then
		-- let go: they go down to the others and can be killed again
		roof_let_go()
	end
	force_online(m.reinf)
	pcall(wake_reinforcements, s, m)
	-- the helicopter and the roof team's duel with it
	local ok, err = pcall(zop_merc_heli.update, m, roof_men())
	if not ok then
		printf("![ZOP] merc heli: %s", tostring(err))
	end
end

------------------------------------------------------------------ the assault
local function tick_assault(s)
	local m = ensure(s)
	protect(true)
	keep_garrison()
	if not on_level() then
		return
	end
	local se_a = smart(ADMIN)
	if se_a and db.actor and not m.breach and db.actor:position():distance_to(se_a.position) < 35 then
		m.breach = true
		say("d06")
	end
end

------------------------------------------------------------------ the army mirror
-- the merc reinforcements that come during the army's assault: ARMY_REINF_AT real seconds after
-- the assault starts, one squad each (enemies at the target: the assault must beat them too)
local ARMY_REINF_AT = { 60, 180 }

local function tick_army(s)
	local m = ensure(s)
	if s.stage ~= "assault" or not on_level() then
		return
	end
	m.secs = (m.secs or 0) + 1
	if not m.went then
		m.went = true
		say("a03")
		m.heli_due = true
		m.army = true    -- zop_merc_heli: no suppression fire around the player, he is on its side
	end
	if m.heli_due and m.secs >= HELI_AT_S then
		m.heli_due = nil
		local ok, err = pcall(zop_merc_heli.spawn, m)
		if not ok then
			printf("![ZOP] army heli spawn: %s", tostring(err))
		end
		mst.heli = m.heli
		say("a06")
	end
	if m.secs >= ROOF_AT_S and not m.roof_done then
		m.roof_done = true
		pcall(roof_spawn)
	end
	m.merc_reinf = m.merc_reinf or {}
	for i, at in ipairs(ARMY_REINF_AT) do
		if m.secs >= at and not m.merc_reinf[i] then
			local id = spawn(REINF_SQUAD, smart(REINF_FROM), HQ)
			m.merc_reinf[i] = id or 0
			if id then
				say("d03")
				news("st_zop_army_merc_reinforce")
			end
		end
	end
	for _, id in pairs(m.merc_reinf) do
		local sq = id ~= 0 and zop_spawn.valid_squad(id, REINF_SQUAD)
		if sq then
			sq.force_online, sq.forced_online_status = true, true
		end
	end
	-- the mercs' roof team stays up there while the heli flies (killable: they are the targets)
	if m.heli and not m.heli_down then
		roof_hold(true)
	elseif next(roof_held) then
		roof_let_go()
	end
	local ok, err = pcall(zop_merc_heli.update, m, roof_men())
	if not ok then
		printf("![ZOP] army heli: %s", tostring(err))
	end
end

------------------------------------------------------------------ events
local function on_start(op_id)
	local s = zop_core.active_state(op_id)
	if not s then
		return
	end
	if op_id == OP_DEF then
		zop_radio.clear()
		say("a01")
		say("a02")
		say("d01")
		pcall(spawn_garrison)
		protect(true)
		if on_level() and MONUMENT.x ~= 0 then
			pcall(mines_place, merc_mine_spots(), HQ, "killer")
		end
	elseif op_id == OP_ADM then
		-- a day and more passed since the defense (the story comes between): the spetsnaz who held
		-- the Administration may be gone - a fresh garrison holds it for the assault
		local left = 0
		for sid, sec in pairs(mst.garrison or {}) do
			if alive_squad(sid, sec) then
				left = left + 1
			end
		end
		if left < 2 then
			pcall(spawn_garrison, OP_ADM)
		end
		if on_level() then
			pcall(mines_place, MINES, ADMIN, "army")
			news("st_zop_killer_admin_mines")
		end
	elseif op_id == OP_ARMY then
		-- Granite gives the order; the mercs' channel is listened in on (Dushman)
		zop_radio.clear()
		say("a01")
		say("d01")
		say("a02")
		if on_level() then
			pcall(mines_place, merc_mine_spots(), HQ, "killer")
		end
	end
end

local function on_wave(op_id, wave)
	if op_id ~= OP_DEF then
		return
	end
	local s = zop_core.active_state(op_id)
	if wave == 1 then
		say("a03")
		pcall(spawn_flank, s)
		-- the helicopter comes a few seconds later (not in the frame the wave is spawned)
		ensure(s).heli_due = true
		say("a06")
	else
		say("a09")
	end
end

local function on_end(op_id, success)
	if op_id == OP_DEF then
		protect(false)
		roof_let_go()
		pcall(zop_merc_heli.leave, mst.heli)
		-- kept until it is gone: a reload during its departure sends it off again
		mst.heli_leaving = mst.heli
		mst.heli = nil
		if success then
			say("a10")
			say("d05")
			-- the garrison and the roof team go on into the assault (mst keeps them)
		else
			-- lost: the army reports its operation done
			zop_radio.clear()
			say("a11")
			mines_clear()
			release_garrison()
			release_roof()
		end
	elseif op_id == OP_ADM then
		mines_clear()
		release_garrison()
		release_roof()
		if success then
			say("d07")
		end
	elseif op_id == OP_ARMY then
		roof_let_go()
		pcall(zop_merc_heli.leave, mst.heli)
		mst.heli_leaving = mst.heli
		mst.heli = nil
		mines_clear()
		release_roof()
		zop_radio.clear()
		-- won: Granite reports the operation done; lost: the mercs keep the city
		say(success and "a11" or "d07")
	end
end

local function actor_on_update()
	roof_hold_frame()
	zop_merc_heli.frame()
	local tg = time_global()
	-- mines: often, a running man covers 4-5 m a second
	if tg >= next_mines and next(mst.mines) then
		next_mines = tg + 150
		if on_level() then
			local ok, err = pcall(mines_check)
			if not ok then
				printf("![ZOP] merc mines: %s", tostring(err))
			end
		end
	end
	if tg < next_tick then
		return
	end
	next_tick = tg + 1000
	if mst.heli_leaving then
		if not alife():object(mst.heli_leaving) then
			mst.heli_leaving = nil
		elseif not mst.leave_armed then
			mst.leave_armed = true
			pcall(zop_merc_heli.leave, mst.heli_leaving)
		end
	end
	local info = zop_core.active_info()
	if not info then
		if next(protected) then
			protect(false)
		end
		return
	end
	local s = zop_core.active_state()
	local ok, err = true, nil
	if info.op_id == OP_DEF then
		ok, err = pcall(tick_defense, s)
	elseif info.op_id == OP_ADM then
		ok, err = pcall(tick_assault, s)
	elseif info.op_id == OP_ARMY then
		ok, err = pcall(tick_army, s)
	end
	if not ok then
		printf("![ZOP] merc %s: %s", info.op_id, tostring(err))
	end
end

-- the roof team takes only ROOF_DMG of the damage (the author: x0.30), all through the operation
local ROOF_DMG = 0.3
-- every hit of every NPC lands here: the roof team's member ids are kept in a set, rebuilt from
-- mst.roof at most every ROOF_IDS_MS (members only change on spawn and death), so a hit costs a
-- table lookup instead of walking the squads
local ROOF_IDS_MS = 2000
local roof_ids, roof_ids_until = {}, 0
local function on_before_hit(npc, s_hit, bone_id, flags)
	if not (npc and s_hit) or not next(mst.roof or {}) then
		return
	end
	local tg = time_global()
	if tg >= roof_ids_until then
		roof_ids, roof_ids_until = {}, tg + ROOF_IDS_MS
		for key, sid in pairs(mst.roof) do
			local sq = zop_spawn.valid_squad(sid, ROOF[key] and ROOF[key].section)
			if sq then
				for m in sq:squad_members() do
					roof_ids[m.id] = true
				end
			end
		end
	end
	if roof_ids[npc:id()] then
		s_hit.power = s_hit.power * ROOF_DMG
	end
end

------------------------------------------------------------------ save / debug
local function save_state(m)
	m.zop_merc = mst
end

local function load_state(m)
	mst = m.zop_merc or {}
	mst.garrison = mst.garrison or {}
	mst.roof = mst.roof or {}
	mst.mines = mst.mines or {}
	mst.leave_armed = nil       -- runtime: re-armed on the first tick
	mine_arm = {}
end

function debug_state()
	return mst
end

function on_game_start()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("npc_on_before_hit", on_before_hit)
	zop_api.on("zop_on_operation_start", on_start)
	zop_api.on("zop_on_wave", on_wave)
	zop_api.on("zop_on_operation_end", on_end)
end
