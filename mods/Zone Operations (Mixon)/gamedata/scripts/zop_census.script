--[[
	Zone Operations (Mixon) - census: who is alive around a smart.
	Online NPCs are counted by distance; offline squads by the smart they are assigned to.
	Only the stalker communities matter here, monsters and zombies are ignored.
	Also the mod's game clock (now / fix_time), shared by every zop_* script.
]]

------------------------------------------------------------------ game clock
-- days from 1970-01-01 to y-m-d of the real calendar (month lengths and leap years counted)
local function days_from_civil(y, m, d)
	if m <= 2 then
		y = y - 1
	end
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local doy = math.floor((153 * ((m + 9) % 12) + 2) / 5) + d - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

-- game time in seconds; saved stamps (cooldowns, deadlines) are compared against it
function now()
	local y, m, d, h, mi, s = game.get_game_time():get()
	return ((days_from_civil(y, m, d) * 24 + h) * 60 + mi) * 60 + s
end

-- Older versions counted every month as 31 days (d + m*31 + y*372): a day was lost or skipped
-- at the end of 30-day months and February. Their stamps are ~6.5e10, ours ~1.3e9 for the
-- game's years, so an old stamp is recognized by its size and moved to this clock keeping
-- the time left (or passed) as it was. Values below OLD_STAMP (0, nil, new stamps) stay.
local OLD_STAMP = 1e10
function fix_time(t)
	if type(t) ~= "number" or t < OLD_STAMP then
		return t
	end
	local y, m, d, h, mi, s = game.get_game_time():get()
	local old_now = ((((d + m * 31 + y * 372) * 24 + h) * 60 + mi) * 60 + s)
	return t - old_now + now()
end

-- fix_time for tbl[k] for every key k of keys (tbl may be nil)
function fix_fields(tbl, keys)
	if type(tbl) ~= "table" then
		return
	end
	for _, k in ipairs(keys) do
		tbl[k] = fix_time(tbl[k])
	end
end

-- fix_time for every value of a map {[id] = stamp} (map may be nil)
function fix_map(map)
	if type(map) ~= "table" then
		return
	end
	for k, v in pairs(map) do
		map[k] = fix_time(v)
	end
end

function smart_by_name(name)
	return SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[name]
end

function level_of(gvid)
	local ok, lv = pcall(function()
		return alife():level_name(game_graph():vertex(gvid):level_id())
	end)
	return ok and lv or nil
end

function actor_near(se_smart, dist)
	local a = db.actor
	if not (a and se_smart) then
		return false
	end
	if level_of(se_smart.m_game_vertex_id) ~= level.name() then
		return false
	end
	return a:position():distance_to(se_smart.position) <= dist
end

local forced = {}   -- [squad id] = true: enemy squads made to come online by count(..., force)

-- lets go of the enemy squads count() forced online (when an operation is over)
function release_forced()
	for sid in pairs(forced) do
		local sq = zop_spawn.valid_squad(sid)
		if sq then
			sq.force_online = nil
			sq.forced_online_status = nil
		end
	end
	forced = {}
end

-- living members of a community within radius of the smart: online NPCs by their position,
-- offline squads assigned to the smart only when they are there too (a squad still on its way
-- does not hold the place). force: such an offline squad is made to come online, so that it can
-- be fought (GAMMA keeps squads within 75 m of the player offline).
-- skip (optional): squad ids left out - story squads that are being evacuated
function count(community, se_smart, radius, skip, force)
	if not (community and se_smart) then
		return 0
	end
	local pos, n = se_smart.position, 0
	for i = 1, #db.OnlineStalkers do
		local id = db.OnlineStalkers[i]
		local o = id and level.object_by_id(id)
		if o and o:alive() and character_community(o) == community and o:position():distance_to(pos) <= radius then
			local se = skip and alife():object(id)
			if not (se and se.group_id and skip[se.group_id]) then
				n = n + 1
			end
		end
	end
	-- SIMBOARD.smarts[id].squads is keyed by squad id (the value is just a flag)
	local sb = SIMBOARD.smarts and SIMBOARD.smarts[se_smart.id]
	if sb and sb.squads then
		local sim = alife()
		for sid in pairs(sb.squads) do
			local sq = sim:object(sid)
			local here = sq and sq.position and sq.position:distance_to(pos) <= radius + 30
			if sq and not sq.online and here and not (skip and skip[sid]) then
				local ok, c, cnt = pcall(function()
					return sq:get_squad_community(), sq:npc_count()
				end)
				if ok and c == community then
					n = n + (cnt or 0)
					if force and not forced[sid] then
						sq.force_online = true
						sq.forced_online_status = true
						forced[sid] = true
					end
				end
			end
		end
	end
	return n
end

-- living online members of tracked squads (game objects), and the distance of the closest
-- member (online or not) to pos
function members(squad_ids, pos)
	local list, best = {}, nil
	local sim = alife()
	for sid in pairs(squad_ids or {}) do
		local sq = zop_spawn.valid_squad(sid)
		if sq then
			for m in sq:squad_members() do
				local o = level.object_by_id(m.id)
				local p
				if o then
					if o:alive() then
						list[#list + 1] = o
						p = o:position()
					end
				else
					local se = sim:object(m.id)
					p = se and se.position
				end
				if p and pos then
					local d = p:distance_to(pos)
					if not best or d < best then
						best = d
					end
				end
			end
		end
	end
	return list, best
end

-- living members of tracked squads (ids of squad server objects)
function alive_in_squads(squad_ids)
	local n = 0
	for sid in pairs(squad_ids or {}) do
		local sq = zop_spawn.valid_squad(sid)
		if sq then
			local ok, c = pcall(function() return sq:npc_count() end)
			if ok and c then
				n = n + c
			end
		end
	end
	return n
end
