--[[
	Zone Operations (Mixon) - raids for the commander's tasks: convoy interception and ambushes.

	A task section uses:
		on_init         = %=zop_raid_setup(<task_id>:<kind>:<faction>:<faction>...)%
		status_functor  = zop_raid_status
		target_functor  = zop_raid_target
		on_complete / on_fail also call %=zop_raid_cleanup(<task_id>)%
	kind:
		convoy - an enemy squad with cargo walks between two smarts of the level; kill it before it
		         arrives. The cargo is on the bodies.
		ambush - an enemy assault group walks from the far side of the level to the commander's
		         base; meet it on the way and kill it before it reaches the base.
		camp   - an enemy group holds a smart of the level; wipe it out before the deadline.
	Stage 0 = hunt, stage 1 = report back to the giver (completed in his dialog, stage_complete = 1).
	The player must take part: if the group dies and none of its members fell to the player
	(or the player's companions), someone else got there first and the task fails.
	State (squad id, route, deadline) is saved; the squad itself is an ordinary alife squad.
]]

-- our own 4-6 man squads (squad_descr_zop.ltx); stock veteran squads are only 2-3 men
local SQUADS = {
	killer   = "zop_raid_killer",
	bandit   = "zop_raid_bandit",
	monolith = "zop_raid_monolith",
	greh     = "zop_raid_greh",
	freedom  = "zop_raid_freedom",
	renegade = "zop_raid_renegade",
	dolg     = "zop_raid_dolg",
	army     = "zop_raid_army",
}

-- what a convoy carries (every member gets one of each)
local CARGO = { "medkit_army", "prt_i_transistors", "prt_i_capacitors", "conserva", "ammo_5.45x39_ap" }

local HOURS   = { convoy = 10, ambush = 8, camp = 24, supply = 24 }

-- "supply": a camp sitting on stolen food (Fin's wagon); every member carries some of it
local FOOD = { "conserva", "kolbasa", "bread", "vodka" }

-- kinds that hold one place instead of walking somewhere
local STAYS = { camp = true, supply = true }
local ARRIVED = 50      -- metres from the destination = the squad got through
local NEAR = 100        -- the player within this many metres of the (online) group = he is in the fight
local NEAR_SECS = 300   -- ...and that counts for 5 game minutes after he was last seen there

local raids = {}        -- [task_id] = { squad, section, kind, faction, to, deadline, who,
                        --   members = {[npc_id] = true}, size, deaths, actor_kills, actor_hits, near_at }

local function now()
	return zop_census.now()
end

local function tr(id, ...)
	local t = game.translate_string(id)
	if select("#", ...) > 0 then
		local ok, s = pcall(string.format, t, ...)
		return ok and s or t
	end
	return t
end

local function news(text)
	if db.actor and text and text ~= "" then
		pcall(news_manager.send_tip, db.actor, text, nil, nil, 12000)
	end
end

local function smart_title(se)
	local ok, t = pcall(smart_terrain.get_smart_terrain_name, se)
	if ok and type(t) == "string" and t ~= "" and t ~= se:name() then return t end
	-- unnamed smart: say the level instead of gar_smart_terrain_5_2
	ok, t = pcall(function()
		return game.translate_string(alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id()))
	end)
	return ok and type(t) == "string" and t ~= "" and t or se:name()
end

local function is_base(s)
	return s.props and s.props.base and s.props.base > 0
end

-- level id of the actor / of a server object (nil if unknown)
local function actor_level_id()
	return db.actor and game_graph():vertex(alife():actor().m_game_vertex_id):level_id()
end

local function level_id_of(se)
	return se and se.m_game_vertex_id and game_graph():vertex(se.m_game_vertex_id):level_id()
end

-- smarts of the actor's level that are not bases, as { se, dist_to_actor }
local function level_smarts()
	local out = {}
	local gg = game_graph()
	local lid = actor_level_id()
	if not lid then
		return out
	end
	local apos = db.actor:position()
	for _, v in pairs(SIMBOARD.smarts) do
		local s = v.smrt
		if s and not is_base(s) and gg:vertex(s.m_game_vertex_id):level_id() == lid then
			out[#out + 1] = { se = s, d = s.position:distance_to(apos) }
		end
	end
	return out
end

local function pick(list, filter)
	local ok = {}
	for _, e in ipairs(list) do
		if filter(e) then
			ok[#ok + 1] = e
		end
	end
	return #ok > 0 and ok[math.random(#ok)] or nil
end

local function pick_faction(factions)
	local ok = {}
	for _, f in ipairs(factions) do
		if SQUADS[f] and ini_sys:section_exist(SQUADS[f]) then
			ok[#ok + 1] = f
		end
	end
	return #ok > 0 and ok[math.random(#ok)] or nil
end

-- route: convoy = two ordinary smarts far apart, away from the player;
--        ambush = far smart -> the giver's base (the smart he stands at, on the actor's level)
-- Every random pick is made only among choices that complete a route, so ready() (the task
-- precondition) and setup() (when the task is taken) agree: if ready() found a route, setup()
-- finds one too, even though both pick at random.
local function route(kind, giver)
	local smarts = level_smarts()
	if STAYS[kind] then
		local at = pick(smarts, function(e) return e.d > 300 and e.d < 1000 end)
		return at and at.se, at and at.se
	end
	if kind == "ambush" then
		local base = giver and giver.m_smart_terrain_id and alife():object(giver.m_smart_terrain_id)
		-- the base must be on this level: positions of different levels are not comparable
		if not base or level_id_of(base) ~= actor_level_id() then
			return nil
		end
		local from = pick(smarts, function(e) return e.d > 450 and e.d < 1100 and e.se.position:distance_to(base.position) > 450 end)
		return from and from.se, base
	end
	local function far_from(f)
		return function(e) return e.se.id ~= f.se.id and e.se.position:distance_to(f.se.position) > 450 end
	end
	-- a start only counts if some destination is far enough from it
	local from = pick(smarts, function(e)
		return e.d > 350 and e.d < 1000 and pick(smarts, far_from(e)) ~= nil
	end)
	if not from then
		return nil
	end
	local to = pick(smarts, far_from(from))
	return from.se, to and to.se
end

-- the giver's server object (or a stand-in that only knows the base smart he is at)
function giver_of(npc)
	-- on_init may get the actor as npc: the giver is whoever the actor is talking to
	local spk = get_speaker and get_speaker(true)
	if not spk or spk:id() == AC_ID then
		spk = npc and npc:id() ~= AC_ID and npc or nil
	end
	local giver = spk and alife():object(spk:id())
	if not (giver and giver.m_smart_terrain_id and giver.m_smart_terrain_id ~= 65535) then
		-- fall back to the base smart nearest to the actor (on his level: other levels reuse coordinates)
		local best, bd
		local lid = actor_level_id()
		for _, v in pairs(SIMBOARD.smarts) do
			local s = v.smrt
			if s and is_base(s) and level_id_of(s) == lid then
				local d = s.position:distance_to(db.actor:position())
				if d < 200 and (not bd or d < bd) then
					best, bd = s, d
				end
			end
		end
		giver = best and { m_smart_terrain_id = best.id } or giver
	end
	return giver
end

-- precondition of a raid task: {=zop_raid_ready(kind)} - this level has a route for it
-- (a task without one would fail the moment it is taken)
local function ready(actor, npc, p)
	local kind = p and p[1]
	if not (kind and HOURS[kind] and db.actor and SIMBOARD and SIMBOARD.smarts) then
		return false
	end
	local ok, se_from, se_to = pcall(route, kind, giver_of(npc))
	return ok and se_from ~= nil and se_to ~= nil
end

------------------------------------------------------------------ effects
-- p[1] task id, p[2] kind, p[3..] factions
local function setup(actor, npc, p)
	local task_id, kind = p[1], p[2]
	if not (task_id and HOURS[kind]) then
		return
	end
	local factions = {}
	for i = 3, #p do
		factions[#factions + 1] = p[i]
	end
	local faction = pick_faction(factions)
	local giver = giver_of(npc)
	local se_from, se_to = route(kind, giver)
	-- the news are signed by whoever gave the task
	local ok_n, name = pcall(function() return giver.character_name and giver:character_name() end)
	local who = ok_n and type(name) == "string" and name ~= "" and name or tr("st_zop_raid_hq")
	if not (faction and se_from and se_to) then
		printf("![ZOP] raid %s: no faction or route (faction=%s)", task_id, tostring(faction))
		raids[task_id] = nil
		return
	end
	local sq = zop_spawn.squad_at_smart(SQUADS[faction], se_from, se_to:name())
	if not sq then
		raids[task_id] = nil
		return
	end
	sq.rush, sq.rush_to_target = false, false
	if kind == "supply" then
		sq.item_on_all = FOOD
	elseif kind == "convoy" then
		sq.item_on_all = CARGO   -- sim_squad_scripted spawns these on every member at first update
	end
	raids[task_id] = {
		squad = sq.id, section = SQUADS[faction], kind = kind, faction = faction,
		to = se_to:name(), deadline = now() + HOURS[kind] * 3600, who = who,
	}
	if STAYS[kind] then
		news(tr("st_zop_raid_" .. kind .. "_news", who, tr(faction), smart_title(se_from)))
	else
		news(tr("st_zop_raid_" .. kind .. "_news", who, tr(faction), smart_title(se_from), smart_title(se_to)))
	end
end

local function cleanup(actor, npc, p)
	local r = p and p[1] and raids[p[1]]
	if r then
		-- survivors go back to the free simulation; the section check keeps a squad that got the
		-- id of a dead raid squad untouched (r.section is nil in very old saves: id check only)
		local se = zop_spawn.valid_squad(r.squad, r.section)
		if se then
			pcall(zop_spawn.steer, se, nil, false)
		end
		raids[p[1]] = nil
	end
end

------------------------------------------------------------------ functors
local function target(task_id, field, p, tsk)
	if field ~= "target" or not tsk then
		return nil
	end
	if tsk.stage == 1 then
		return tsk.task_giver_id
	end
	local r = raids[task_id]
	local sq = r and zop_spawn.valid_squad(r.squad, r.section)
	if sq then
		local ok, cid = pcall(function() return sq:commander_id() end)
		return ok and cid or sq.id
	end
	return nil
end

local function status(tsk, task_id)
	if axr_task_manager.is_task_giver_valid and not axr_task_manager.is_task_giver_valid(tsk) then
		return "fail"
	end
	if tsk.stage == 254 then
		return "fail"
	end
	if tsk.stage ~= 0 then
		return
	end
	local r = raids[task_id]
	if not r then
		return "fail"
	end
	local sq = zop_spawn.valid_squad(r.squad, r.section)
	local ok, n = pcall(function() return sq and sq:npc_count() or 0 end)
	if ok and n > 0 and db.actor then
		-- keep the member ids: at npc_on_death_callback the victim is already out of its squad
		-- (get_object_squad returns nil), so deaths are matched by id
		r.members = r.members or {}
		pcall(function()
			for m in sq:squad_members() do
				r.members[m.id] = true
			end
		end)
		if not r.size or n > r.size then
			r.size = n
		end
		-- remember whether the player was close to the group lately (kills by explosions or
		-- other indirect means may not name the actor as the killer); online squads only,
		-- so positions on another level never match
		if sq.online then
			local d = sq.position and sq.position:distance_to(db.actor:position())
			if d and d < NEAR then
				r.near_at = now()
			end
		end
	end
	local took_part = (r.actor_kills or 0) > 0 or (r.actor_hits or 0) > 0
		or (r.near_at and now() - r.near_at < NEAR_SECS)
	if not ok or n == 0 then
		if took_part then
			tsk.stage = 1      -- all dead and the player was there: report to the giver
			return
		end
		if r.size and (r.deaths or 0) < r.size then
			-- the group vanished without being killed (emission, despawn by another mod):
			-- nobody beat the player to it, so no "someone got there first" message
			printf("![ZOP] raid %s: group vanished (%s of %s died)", task_id, r.deaths or 0, r.size)
			return "fail"
		end
		news(tr("st_zop_raid_beaten", r.who or tr("st_zop_raid_hq")))
		return "fail"          -- someone else got there first
	end
	if now() > r.deadline then
		return "fail"
	end
	-- a fight at the destination itself does not count as "they got through"
	local se_to = not STAYS[r.kind] and zop_census.smart_by_name(r.to)
	if se_to and not took_part and sq.position:distance_to(se_to.position) < ARRIVED then
		return "fail"          -- they got through
	end
end

------------------------------------------------------------------ who killed them
local function by_player(who)
	if not who then
		return false
	end
	local ok, res = pcall(function()
		local id = who:id()
		if id == AC_ID then
			return true
		end
		-- a weapon or grenade held by the actor (some mods report it as the killer)
		local p = who.parent and who:parent()
		if p and p:id() == AC_ID then
			return true
		end
		-- the player's companions count too
		local sq = get_object_squad(who)
		return sq and axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[sq.id] and true or false
	end)
	return ok and res or false
end

-- raid records whose group the victim belongs to
local function raids_of(victim)
	local out = {}
	local ok, sq = pcall(get_object_squad, victim)
	local sid = ok and sq and sq.id
	local vid = victim:id()
	for _, r in pairs(raids) do
		if (sid and r.squad == sid) or (r.members and r.members[vid]) then
			out[#out + 1] = r
		end
	end
	return out
end

-- a member died: count it, credit the player if it was him, and forget the id
-- (the engine may give it to another object later)
local function member_died(r, id, by_actor)
	r.deaths = (r.deaths or 0) + 1
	if by_actor then
		r.actor_kills = (r.actor_kills or 0) + 1
	end
	if r.members then
		r.members[id] = nil
	end
end

local function npc_on_death_callback(victim, who)
	if not (victim and next(raids)) then
		return
	end
	pcall(function()
		local list = raids_of(victim)
		if #list == 0 then
			return
		end
		local mine = by_player(who)
		for _, r in ipairs(list) do
			member_died(r, victim:id(), mine)
		end
	end)
end

-- sim_squad_scripted:on_npc_death raises this for every member death, online or offline, before
-- the client npc_on_death_callback; whichever comes first counts the death and drops the id
local function squad_on_npc_death(squad, se_npc, se_killer)
	if not (se_npc and next(raids)) then
		return
	end
	pcall(function()
		local id = se_npc.id
		local mine = false
		if se_killer then
			if se_killer.id == AC_ID then
				mine = true
			else
				local ksq = se_killer.group_id and se_killer.group_id ~= 65535 and se_killer.group_id
				mine = ksq and axr_companions and axr_companions.companion_squads
					and axr_companions.companion_squads[ksq] and true or false
			end
		end
		local sid = squad and squad.id
		for _, r in pairs(raids) do
			if (sid and r.squad == sid) or (r.members and r.members[id]) then
				member_died(r, id, mine)
			end
		end
	end)
end

-- any hit by the player or his companions on a member counts as taking part
-- (the first hit is also where the victim's squad is still known)
local function npc_on_hit_callback(victim, amount, dir, who, bone)
	if not (victim and next(raids)) then
		return
	end
	pcall(function()
		local list = raids_of(victim)
		if #list == 0 or not by_player(who) then
			return
		end
		for _, r in ipairs(list) do
			r.actor_hits = (r.actor_hits or 0) + 1
		end
	end)
end

------------------------------------------------------------------ save / load
local function save_state(m)
	m.zop_raid = raids
end

local function load_state(m)
	raids = m.zop_raid or {}
	-- deadlines saved by versions with the 31-day-month clock
	for _, r in pairs(raids) do
		zop_census.fix_fields(r, { "deadline" })
	end
end

function on_game_start()
	xr_effects.zop_raid_setup = setup
	xr_effects.zop_raid_cleanup = cleanup
	xr_conditions.zop_raid_ready = ready
	task_functor.zop_raid_target = target
	task_status_functor.zop_raid_status = status
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("npc_on_hit_callback", npc_on_hit_callback)
	RegisterScriptCallback("squad_on_npc_death", squad_on_npc_death)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
