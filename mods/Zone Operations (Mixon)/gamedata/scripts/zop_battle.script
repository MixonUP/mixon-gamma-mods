--[[
	Zone Operations (Mixon) - battle: makes a fight actually happen at a base smart.

	Found in testing at Yanov (all three are stock behaviour of base smarts):
	1. job logic of a base gives its NPCs combat_ignore_cond / no_combat_job, and squads that
	   reach the smart take those jobs too -> both sides stand in peace;
	2. xr_combat_ignore.is_enemy ignores an enemy that is not fresh in memory -> newcomers
	   never pick each other as enemies;
	3. base jobs carry invulnerable = {=npc_in_zone(safe_restr)} true, re-applied every update
	   through stalker_generic.is_need_invulnerability -> nobody can be killed.

	While an operation fights at a target and the player is near, zop_core calls engage().
	That opens a battle zone (smart position, radius, the two communities) for a few seconds;
	engage() keeps renewing it. Inside the zone, for those two communities only:
	- on_enemy_eval reports the other side as an enemy (flags.override);
	- is_need_invulnerability returns false;
	- the peace overrides are dropped and each side is made visible to the other.
	The zone expires by itself, so nothing stays changed after the fight or after a reload.
]]

local PERIOD_MS = 3000
local ZONE_MS   = 8000

-- one zone per fighting smart (a two-sided assault fights at two smarts at once)
local zones = {}       -- [smart id] = { pos, r2, a, b, expires }
local next_run = {}    -- [smart id] = time_global of the next heavy pass
local orig_need_inv

local revealed = {}    -- [attacker id] = { zid, enemy = { [community] = true }, expires } (set by reveal)

local function in_z(z, obj, c)
	return (c == z.a or c == z.b) and obj:position():distance_to_sqr(z.pos) <= z.r2
end

-- some zone that holds this NPC (only to switch invulnerability off)
local function zone_of(obj)
	if not (obj and next(zones)) then
		return nil
	end
	local tg = time_global()
	local ok, c = pcall(character_community, obj)
	if not ok then
		return nil
	end
	for id, z in pairs(zones) do
		if tg > z.expires then
			zones[id] = nil
		elseif in_z(z, obj, c) then
			return z, c
		end
	end
end

-- a revealed attacker (possibly far outside the zone) against a defender inside its zone
local function revealed_pair(att, def, c_def, tg)
	local r = revealed[att:id()]
	if not (r and tg <= r.expires and r.enemy[c_def]) then
		return false
	end
	local z = zones[r.zid]
	return z ~= nil and def:position():distance_to_sqr(z.pos) <= z.r2
end

------------------------------------------------------------------ hooks
local function on_enemy_eval(obj, enemy, flags)
	if not next(zones) then
		return
	end
	local ok, ca, cb = pcall(function() return character_community(obj), character_community(enemy) end)
	if not ok or ca == cb then
		return
	end
	local tg = time_global()
	local hit = false
	local ok2 = pcall(function()
		-- the stealth overhaul ignores enemies beyond ~150 m that have not seen us: attackers
		-- standing far out would never start, so a revealed pair counts whatever the distance
		if revealed_pair(obj, enemy, cb, tg) or revealed_pair(enemy, obj, ca, tg) then
			hit = true
			return
		end
		-- zones may overlap: any zone holding both sides counts
		for id, z in pairs(zones) do
			if tg > z.expires then
				zones[id] = nil
			elseif in_z(z, obj, ca) and in_z(z, enemy, cb) then
				hit = true
				return
			end
		end
	end)
	if ok2 and hit then
		flags.override = true
		flags.result = true
	end
end

-- a story NPC of our own side (Loki and Ashot defending Yanov) keeps whatever protection he has:
-- the battle only opens up the fighters, and the enemy's story NPCs are evacuated instead
-- NPCs an operation script keeps unkillable (zop_merc: the HQ's story NPCs, the roof team)
keep_protected = {}      -- [npc id] = true

local function own_story(obj, c, z)
	if keep_protected[obj:id()] then
		return true
	end
	if c ~= z.a then
		return false
	end
	local id = obj:id()
	if get_object_story_id(id) then
		return true
	end
	local se = alife():object(id)
	local sid = se and se.group_id
	return sid ~= nil and sid ~= 65535 and get_object_story_id(sid) ~= nil
end

local function need_inv_wrapper(npc)
	local z, c = nil, nil
	if npc then
		z, c = zone_of(npc)
	end
	if z and not own_story(npc, c, z) then
		return false
	end
	return orig_need_inv(npc)
end

local function install()
	if orig_need_inv or not (stalker_generic and stalker_generic.is_need_invulnerability) then
		return
	end
	orig_need_inv = stalker_generic.is_need_invulnerability
	stalker_generic.is_need_invulnerability = need_inv_wrapper
end

------------------------------------------------------------------ engage
local function clear_overrides(id)
	local st = db.storage[id] and db.storage[id].overrides
	if st then
		st.combat_ignore = nil
		st.enemy_ignore = nil
		st.no_combat_job = nil
	end
end

-- 4. the melee "facer" scheme (xrs_facer, GAMMA) wins over the combat planner when the enemy
-- is within ~2 m: NPCs who took base jobs next to each other just stand and stare. The
-- scheme stays off while its abtime is in the future, so keep pushing it ahead.
local function hold_facer(o)
	local st = db.storage[o:id()]
	if st and st.facer then
		local t = time_global() + 10000
		st.facer.abtime = t
		st.facer.check_time = t
	end
	pcall(save_var, o, "facer_target", nil)
end

-- 5. friendly fire check (vanilla rx_ff): every neutral that stands near the muzzle or on the
-- aim line counts as a friend, so in a base full of loners and traders nobody fires.
-- For the fighters we swap the evaluator for a constant "may shoot" and restore it afterwards.
local ff_swapped = {}   -- [npc id] = true

function ff_off(o)
	local id = o:id()
	if ff_swapped[id] or not (rx_ff and rx_ff.evaid) or character_community(o) == "zombied" then
		return
	end
	-- only an NPC whose friendly-fire evaluator is set up (one that has just come online may not
	-- have it yet: removing a missing evaluator is not safe in the engine)
	if not (db.storage[id] and db.storage[id].rx_ff) then
		return
	end
	local ok = pcall(function()
		local m = o:motivation_action_manager()
		m:remove_evaluator(rx_ff.evaid)
		m:add_evaluator(rx_ff.evaid, property_evaluator_const(false))
		db.storage[id].rx_dont_shoot = false
	end)
	if ok then
		ff_swapped[id] = true
	end
end

local function ff_restore_all()
	for id in pairs(ff_swapped) do
		local o = level.object_by_id(id)
		local st = db.storage[id]
		if o and o:alive() and st and st.rx_ff then
			pcall(function()
				local m = o:motivation_action_manager()
				m:remove_evaluator(rx_ff.evaid)
				m:add_evaluator(rx_ff.evaid, rx_ff.evaluator_dont_shoot(o, "eva_dont_shoot", st.rx_ff))
			end)
		end
		ff_swapped[id] = nil
	end
end

-- side_a / side_b: community names; radius: metres around the smart
function engage(se_smart, side_a, side_b, radius)
	if not se_smart then
		return
	end
	install()
	local tg = time_global()
	local zid = se_smart.id
	zones[zid] = { pos = se_smart.position, r2 = radius * radius, a = side_a, b = side_b, expires = tg + ZONE_MS }
	if tg < (next_run[zid] or 0) then
		return
	end
	next_run[zid] = tg + PERIOD_MS
	local A, B = {}, {}
	for i = 1, #db.OnlineStalkers do
		local id = db.OnlineStalkers[i]
		local o = id and level.object_by_id(id)
		local c = o and o:alive() and character_community(o)
		if c and in_z(zones[zid], o, c) then
			if c == side_a then
				A[#A + 1] = o
			elseif c == side_b then
				B[#B + 1] = o
			end
		end
	end
	if #A == 0 or #B == 0 then
		return
	end
	for _, list in ipairs({ A, B }) do
		for _, o in ipairs(list) do
			clear_overrides(o:id())
			hold_facer(o)
			ff_off(o)
			if o:invulnerable() and not own_story(o, character_community(o), zones[zid]) then
				o:invulnerable(false)
			end
		end
	end
	-- cap the pairs so a big base does not cost a frame spike
	for i = 1, math.min(#A, 12) do
		for j = 1, math.min(#B, 12) do
			pcall(function()
				A[i]:make_object_visible_somewhen(B[j])
				B[j]:make_object_visible_somewhen(A[i])
			end)
		end
	end
end

-- Attackers that reached a small smart (a checkpoint with 2 jobs) get no job there and so no
-- logic: they stand where the squad "arrived", up to 200 m away. Showing them the defenders
-- hands them to the combat planner, which walks them in. Found on the Garbage checkpoint.
local next_reveal = {}  -- [smart id]
-- enemy: a community name or a list of them (a defense: our faction and its allies). The pass
-- is throttled per smart, so everybody who holds one smart must come in one call.
-- max_dist (optional): only attackers this close to the smart are shown. Nobody passes it now:
-- a wave or a counterattack that is capped stops short and never comes on.
-- opts (optional, the counterattack):
--   busy  = true: an attacker whose current enemy is an outsider (not one of `enemy`: army or
--           mutants met on the way) is shown the defenders too, not only an idle one
--   actor = true: the attackers are shown the player as well
function reveal(squad_ids, se_smart, enemy, radius, max_dist, opts)
	if not (se_smart and enemy) then
		return
	end
	opts = opts or {}
	local enemies = {}
	if type(enemy) == "table" then
		for _, c in ipairs(enemy) do
			enemies[c] = true
		end
	else
		enemies[enemy] = true
	end
	local tg = time_global()
	-- opts.own_clock: the caller throttles itself (a second set of squads at the same smart)
	if not opts.own_clock then
		if tg < (next_reveal[se_smart.id] or 0) then
			return
		end
		next_reveal[se_smart.id] = tg + PERIOD_MS
	end
	local A, B = {}, {}
	for sid in pairs(squad_ids or {}) do
		local se = zop_spawn.valid_squad(sid)
		if se then
			for m in se:squad_members() do
				local o = level.object_by_id(m.id)
				if o and o:alive() and (not max_dist
					or o:position():distance_to_sqr(se_smart.position) <= max_dist * max_dist) then
					revealed[m.id] = { zid = se_smart.id, enemy = enemies, expires = tg + ZONE_MS }
					local be = o:best_enemy()
					local take = not be
					if be and opts.busy then
						local ok, c = pcall(character_community, be)
						take = not (ok and enemies[c])
					end
					if take then
						A[#A + 1] = o
						if opts.wake then
							-- defenders sent in from outside: the base's peace overrides and the
							-- friendly-fire check would keep them idle
							clear_overrides(o:id())
							hold_facer(o)
							ff_off(o)
						end
					end
				end
			end
		end
	end
	if #A == 0 then
		return
	end
	-- busy attackers stay in the list until they turn to the defenders: a wider cap, so the
	-- first squads cannot crowd the others out (fewer defenders each, the cost stays the same)
	local cap_a, cap_b = 12, 12
	if opts.busy then
		cap_a, cap_b = 24, 8
	end
	if opts.actor and db.actor then
		for i = 1, math.min(#A, cap_a) do
			pcall(function() A[i]:make_object_visible_somewhen(db.actor) end)
		end
	end
	local r2 = radius * radius
	for i = 1, #db.OnlineStalkers do
		local o = level.object_by_id(db.OnlineStalkers[i])
		if o and o:alive() and enemies[character_community(o)] and o:position():distance_to_sqr(se_smart.position) <= r2 then
			B[#B + 1] = o
		end
	end
	for i = 1, math.min(#A, cap_a) do
		for j = 1, math.min(#B, cap_b) do
			pcall(function()
				A[i]:make_object_visible_somewhen(B[j])
				B[j]:make_object_visible_somewhen(A[i])
			end)
		end
	end
end

-- Defenders of `faction` within `radius` of the smart that have no enemy yet are shown every
-- living member of the attacking squads (a counterattack comes from 200+ m away).
local next_reveal_to = 0
function reveal_to(faction, se_smart, radius, attacker_ids)
	if not se_smart or time_global() < next_reveal_to then
		return
	end
	next_reveal_to = time_global() + PERIOD_MS
	local B = {}
	for sid in pairs(attacker_ids or {}) do
		local se = zop_spawn.valid_squad(sid)
		if se then
			for m in se:squad_members() do
				local o = level.object_by_id(m.id)
				if o and o:alive() then
					B[#B + 1] = o
				end
			end
		end
	end
	if #B == 0 then
		return
	end
	local r2, n = radius * radius, 0
	for i = 1, #db.OnlineStalkers do
		local o = level.object_by_id(db.OnlineStalkers[i])
		if o and o:alive() and not o:best_enemy() and character_community(o) == faction
			and o:position():distance_to_sqr(se_smart.position) <= r2 then
			n = n + 1
			-- the base's peace overrides, the facer and the friendly-fire check would keep them idle
			clear_overrides(o:id())
			hold_facer(o)
			ff_off(o)
			for j = 1, math.min(#B, 12) do
				pcall(function() o:make_object_visible_somewhen(B[j]) end)
			end
			if n >= 16 then
				break
			end
		end
	end
end

function stop()
	zones, revealed, next_run, next_reveal = {}, {}, {}, {}
	next_reveal_to = 0
	ff_restore_all()
end

-- once the zone has expired (fight over, player left), give the fighters their checks back
local function actor_on_update()
	if not next(ff_swapped) then
		return
	end
	local tg = time_global()
	for id, z in pairs(zones) do
		if tg > z.expires then
			zones[id] = nil
		end
	end
	if not next(zones) then
		ff_restore_all()
	end
end

function on_game_start()
	RegisterScriptCallback("on_enemy_eval", on_enemy_eval)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
