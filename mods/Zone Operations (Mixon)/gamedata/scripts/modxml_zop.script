local warned = false

local function inject(xml, text, what)
	local ok, err = pcall(function() xml:insertFromXMLString(text) end)
	if not ok then
		printf("![ZOP] DXML %s patch failed: %s", what, tostring(err))
	end
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(name, xml)
		if name == [[gameplay\dialogs.xml]] then
			local ok, err = pcall(function() xml:insertFromXMLString(DIALOG) end)
			if not ok and not warned then
				warned = true
				printf("![ZOP] DXML dialog patch failed: %s", tostring(err))
			end
			inject(xml, mixon_talk(), "Mixon talk")
		elseif name == [[gameplay\npc_profile.xml]] then
			inject(xml, COMMANDER_PROFILE, "npc_profile")
			inject(xml, FREEDOM_PROFILE, "freedom npc_profile")
			inject(xml, CSKY_PROFILE, "csky npc_profile")
			inject(xml, CSKY2_PROFILE, "csky2 npc_profile")
		elseif name == [[gameplay\character_desc_jupiter.xml]] then
			inject(xml, COMMANDER_DESC, "commander profile")
			inject(xml, FREEDOM_DESC, "freedom commander profile")
			inject(xml, CSKY_DESC, "csky commander profile")
			inject(xml, CSKY2_DESC, "csky2 profiles")
		end
	end)
end

function on_game_start()
	local ok, err = pcall(function()
		RegisterScriptCallback("on_specific_character_dialog_list", function(character_id, dialog_list)
			if zop_registry.is_giver(character_id) then
				dialog_list:add("zop_offer_dialog")
			end
			-- Loki gives Freedom's mirror of Colonel Mixon's tasks (jup_a6_freedom_leader_task_N);
			-- his stock profile has no generic task dialogs
			if character_id == "jup_a6_freedom_leader" then
				dialog_list:add("dm_ordered_task_dialog")
				dialog_list:add("dm_ordered_task_completed_dialog")
			end
		end)
	end)
	if not ok then
		printf("![ZOP] dialog hook failed: %s", tostring(err))
	end
end
