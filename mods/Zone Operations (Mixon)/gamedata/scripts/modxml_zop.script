--[[
	Zone Operations (Mixon) - DXML: one generic offer dialog, added to every commander that
	gives an operation (zop_registry.is_giver). Its text comes from the operation itself.
	Also adds the profile of the Duty commander who takes over captured Yanov
	(npc section zop_dolg_commander, see configs\mod_system_zop.ltx).
	No foreign file is overwritten.
]]

local DIALOG = [[
<dialog id="zop_offer_dialog">
	<precondition>zop_core.dlg_can_offer</precondition>
	<phrase_list>
		<phrase id="0">
			<text>st_zop_dlg_ask</text>
			<next>1</next>
		</phrase>
		<phrase id="1">
			<script_text>zop_core.dlg_offer_text</script_text>
			<next>2</next>
			<next>3</next>
		</phrase>
		<phrase id="2">
			<text>st_zop_dlg_accept</text>
			<action>zop_core.dlg_accept</action>
		</phrase>
		<phrase id="3">
			<text>st_zop_dlg_decline</text>
		</phrase>
	</phrase_list>
</dialog>
]]

-- Colonel Mixon's talk: who he is, the situation at Yanov, Duty's reason to hold it, the Zone.
-- Every answer leads back to the same list of questions, "bye" ends the talk.
local function mixon_talk()
	local MENU = { "q_who", "q_sit", "q_why", "q_zone", "q_mon", "bye" }
	local P = "st_zop_mx_"
	local id = {}
	local n = 1 -- 0 and 1 are taken by the start and menu phrases
	local function new(key) n = n + 1; id[key] = n; return n end
	-- fixed ids: 0 = actor start, 1 = npc menu
	local out = {}
	local function phrase(pid, text, nexts)
		local t = { string.format('<phrase id="%d"><text>%s%s</text>', pid, P, text) }
		for _, nx in ipairs(nexts or {}) do
			t[#t + 1] = string.format("<next>%d</next>", nx)
		end
		t[#t + 1] = "</phrase>"
		out[#out + 1] = table.concat(t)
	end
	for _, k in ipairs(MENU) do new(k) end
	local chain = {
		q_who = { "a_who1", "q_who2", "a_who2", "q_who3", "a_who3", "q_name", "a_name" },
		q_sit = { "a_sit" },
		q_why = { "a_why" },
		q_zone = { "a_zone1", "q_zone2", "a_zone2" },
		q_mon = { "a_mon" },
	}
	for _, list in pairs(chain) do
		for _, k in ipairs(list) do new(k) end
	end
	local menu_ids = {}
	for _, k in ipairs(MENU) do menu_ids[#menu_ids + 1] = id[k] end
	phrase(0, "start", { 1 })
	phrase(1, "menu", menu_ids)
	for _, k in ipairs(MENU) do
		local list = chain[k]
		if list then
			phrase(id[k], k, { id[list[1]] })
			for i, step in ipairs(list) do
				local nxt = list[i + 1]
				phrase(id[step], step, nxt and { id[nxt] } or menu_ids)
			end
		else
			phrase(id[k], k, nil) -- bye
		end
	end
	return '<dialog id="zop_mixon_talk"><phrase_list>' .. table.concat(out) .. "</phrase_list></dialog>"
end

