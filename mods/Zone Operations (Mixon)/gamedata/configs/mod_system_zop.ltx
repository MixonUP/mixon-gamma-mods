; Courier cargo for the runs between the two Clear Sky bases: Kholodny (Jupiter) <-> Viking (Agroprom factory).
; Tasks zop_csky_commander_task_23/24 and zop_csky_viking_task_7/8, see scripts\zop_courier.script.
; They inherit the stock delivery packages quest_package_N, so the icon is whatever the installed icon pack
; gives the stock package (GAMMA's GRIP remaps it by section: another texture, another cell and scale).
; Own story_id (the stock one would be shared with the real package) and no "unpack" (zop_courier.cargo_menu).

; a sealed case with a large batch of artefacts for Viking's lab
[zop_courier_artefacts]:quest_package_1
$spawn              = "quest_items\zop_courier_artefacts"
story_id            = zop_courier_artefacts
inv_weight          = 14.0
inv_name            = st_zop_courier_artefacts_name
inv_name_short      = st_zop_courier_artefacts_name
description         = st_zop_courier_artefacts_descr
use1_functor        = zop_courier.cargo_menu
use1_action_functor = zop_courier.cargo_use

; the checkpoint's field archive: measurement logs and reports
[zop_courier_documents]:quest_package_4
$spawn              = "quest_items\zop_courier_documents"
story_id            = zop_courier_documents
inv_weight          = 3.0
inv_name            = st_zop_courier_documents_name
inv_name_short      = st_zop_courier_documents_name
description         = st_zop_courier_documents_descr
use1_functor        = zop_courier.cargo_menu
use1_action_functor = zop_courier.cargo_use

