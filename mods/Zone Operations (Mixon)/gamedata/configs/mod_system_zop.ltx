; Zone Operations (Mixon) - NPC sections (DLTX: added to system.ltx)
; Duty commander who takes over Yanov after duty_yanov. His profile is added by modxml_zop.script,
; his tasks are [zop_dolg_commander_task_N] (Anomaly picks tasks by npc section name).
[zop_dolg_commander]:stalker
$spawn            = "respawn\zop_dolg_commander"
character_profile = zop_dolg_commander
spec_rank         = legend
community         = dolg

