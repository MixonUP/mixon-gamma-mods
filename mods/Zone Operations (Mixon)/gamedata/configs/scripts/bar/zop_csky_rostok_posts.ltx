; Zone Operations (Mixon): the Clear Sky trader Kompas by the road to the Wild Territory
; (first version of csky_rostok; no operation sends him now - the post stays for saves that have him,
; nobody else can take it)
; posts of Clear Sky's people at bar_zastava_dogs_lair_2 (exclusive jobs, see smart\mod_bar_zastava_dogs_lair_2_zop.ltx)
; beh_cover walks the NPC to the exact level vertex and plays wait_anim there

[logic@zop_csky_rostok_trader]
suitable = {=check_npc_name(zop_csky_rostok_trader)} true
prior = 50
active = beh@zop_csky_rostok_trader
trade = items\trade\trade_csky_spore.ltx
level_spot = trader

[beh@zop_csky_rostok_trader]
behavior_state = beh_cover
target = lvid:26555
wait_anim = animpoint_stay_wall
meet = meet@zop_csky_rostok

[meet@zop_csky_rostok]
; they stay at their place when the player comes: no talk animation, no greeting
close_anim = nil
far_anim = nil
close_snd_hello = nil
close_snd_bye = nil
use = true
