blocks         = duty_yanov
reward_money   = 75000
goodwill       = 250
cooldown_days  = 7

; ------------------------------------------------------------------------------------------
; Clear Sky chain: Marsh -> Agroprom factory (main base) -> the scientists' bunker on Yantar
; (operation id csky_rostok) -> Jupiter checkpoint
; ------------------------------------------------------------------------------------------
; The small factory on Agroprom (gate, courtyard, building): full of soldiers when we come;
; after it falls the army counterattacks, and once beaten offers a truce. Clear Sky's main base.
[csky_factory]
actor_faction  = csky
giver          = mar_smart_terrain_base_stalker_leader_marsh
type           = assault
targets        = agr_smart_terrain_4_4_near_3, agr_smart_terrain_4_4_near_1, agr_smart_terrain_4_4_near_2, agr_smart_terrain_4_4
enemy          = army
requires       = csky_marsh
evict          = true
occupy_squad   = zop_army_occupy
occupy_count   = 2
ally_squad     = zop_csky_assault
ally_count     = 4
radius         = 50
capture        = true
garrison_squad = zop_csky_garrison
garrison_count = 1
counter_squad  = zop_army_counter
counter_count  = 4
counter_delay_seconds = 300
counter_target = agr_smart_terrain_4_4
services       = zop_csky_mechanic_squad, zop_csky_arsenal_squad, zop_csky_barman_squad, zop_csky_viking_squad
services_home  = agr_smart_terrain_4_4
services_escort = zop_csky_garrison
services_delay_hours = 2
trader_trade   = items\trade\trade_csky_spore.ltx
props          = placeable_chair@0.34,2.50,6.46@-75, placeable_chair@-6.25,7.50,4.70@134, placeable_table1@-5.60,7.50,4.08@134, placeable_lamp1@-5.60,8.35,4.08@134
reinforce_count = 2
reinforce_at   = 3
reinforce_max  = 1
reward_money   = 60000
goodwill       = 300
cooldown_days  = 5

; Four days after the factory the scientists on Yantar call for help: a strange group of the dead
; is coming at their bunker, and the Monolith follows. Viking sends a rapid response group; the
; bunker stays the scientists', we only help them hold it. Afterwards the scientists are our friends.
; (the id csky_rostok is kept so that saves taken with this operation stay valid; the Clear Sky
; trader Kompas it used to bring to Rostok is no longer sent by any operation)
[csky_rostok]
actor_faction  = csky
giver          = zop_csky_viking
type           = defense
targets        = yan_smart_terrain_6_4
enemy          = zombied
requires       = csky_factory
requires_days  = 4
; three waves of 20 of the strongest dead, then six Monolith squads of veterans, masters and legends
waves          = zop_zombied_elite:4, zop_zombied_elite:4, zop_zombied_elite:4, zop_monolith_elite:6
; the waves come out by the campfire with the pipe, 95 m from the bunker
wave_spawn     = 94.98,-9.31,-224.67@110933@2200
; the Monolith (wave 4) comes from further out, from the side of the Wild Territory exit
wave_spawn_4   = 170.10,4.85,-252.00@148376@2200
delay_hours    = 1
radius         = 70
allies         = ecolog
defender_squad = zop_csky_assault
defender_count = 4
reinforce_count = 2
reinforce_at   = 3
reinforce_max  = 1
start_news     = st_zop_csky_rostok_alarm, st_zop_csky_rostok_order
success_news   = st_zop_csky_rostok_thanks
peace_on_success = ecolog
; afterwards Kompas, the Clear Sky trader, and his guard stay by the bunker (working with the scientists)
success_spawn  = zop_csky_rostok_trader_squad, zop_csky_garrison
reward_money   = 50000
goodwill       = 250
cooldown_days  = 3

; Viking gives it five days after the bunker: the Jupiter checkpoint, held by a mass of Monolith
; veterans; five minutes after it falls they counterattack. Then Clear Sky's northern base:
; Kholodny in charge, a medic, a trader, a mechanic and a barman. Only Kholodny has a post so far
; (configs\scripts\jupiter\zop_csky_jupiter_posts.ltx); the other four take the smart's ordinary jobs
; until their places are marked.
[csky_jupiter]
actor_faction  = csky
giver          = zop_csky_viking
type           = assault
targets        = jup_a10_smart_terrain
enemy          = monolith
requires       = csky_rostok
requires_days  = 5
; the north kills by psy field until the Brain Scorcher is off (also given in non-story modes)
requires_info  = bar_deactivate_radar_done
evict          = true
occupy_squad   = zop_monolith_pro
occupy_count   = 4
ally_squad     = zop_csky_assault
ally_count     = 5
radius         = 60
capture        = true
garrison_squad = zop_csky_garrison
garrison_count = 2
counter_squad  = zop_monolith_pro
counter_count  = 4
counter_delay_seconds = 300
services       = zop_csky_kholodny_squad, zop_csky_racuro_squad, zop_csky_salazar_squad, zop_csky_kruger_squad, zop_csky_fin_squad
services_escort = zop_csky_garrison
services_delay_hours = 3
trader_trade   = items\trade\trade_csky_spore.ltx
reinforce_count = 2
reinforce_at   = 3
reinforce_max  = 1
; the mechanic's corner: the portable workbench with tools and a chair behind it (the chair's seat is
; at 7.00,-190.40 - the mechanic's post, zop_csky_jupiter_posts.ltx; both face east, into the room)
props          = placeable_chair@7.17,24.62,-190.40@0, placeable_workshop@7.90,24.62,-190.40@90
reward_money   = 90000
goodwill       = 400
cooldown_days  = 5
