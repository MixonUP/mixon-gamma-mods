type           = assault
targets        = bar_zastava, bar_zastava_2, bar_dolg_general, bar_dolg_bunker
enemy          = dolg
requires       = freedom_garbage
ally_squad     = zop_freedom_assault
ally_count     = 3
; two sides at once: the main group comes up from the Garbage onto the south checkpoint,
; the second group comes down from the north-west onto the north checkpoint
muster         = bar_zastava_dogs_lair
flank_muster   = bar_zastava_dogs_lair_2
flank_target   = bar_zastava_2
flank_count    = 2
radius         = 60
evacuate       = bar_dolg_leader_squad:zat_stalker_base_smart, bar_dolg_general_petrenko_stalker_squad:zat_stalker_base_smart, bar_dolg_general_zoneguard_stalker_squad:zat_stalker_base_smart, bar_zastava_2_commander_squad:zat_stalker_base_smart, bar_duty_security_squad_leader_squad:zat_stalker_base_smart, bar_dolg_medic_squad:zat_stalker_base_smart, bar_visitors_stalker_mechanic_squad:zat_stalker_base_smart
