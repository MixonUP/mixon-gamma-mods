radius         = 90
evacuate       = jup_a6_freedom_leader_squad:mil_smart_terrain_7_7, jup_a6_freedom_trader_ashot_squad:mil_smart_terrain_7_7
capture        = true
garrison_squad = zop_dolg_garrison
garrison_count = 2
services       = zop_dolg_services
services_escort = zop_dolg_garrison
services_delay_hours = 3
trader_trade   = items\trade\trade_duty.ltx
blocks         = freedom_yanov
reward_money   = 40000
